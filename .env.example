# Copy to .env. Git ignores .env, and the key never leaves the backend.
#
# Works without a key: retrieval, ranked passages with source metadata, the
# no-match state, the frontend, all tests, and the free evaluation commands.
# Needs OPENAI_API_KEY: generated answers with citations (ANSWER_PROVIDER=openai)
# and the paid answer-quality evaluation commands.
#
# Local preview makes no API calls. Set openai to enable document-only answers.
ANSWER_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Retrieval is independent of the answer provider: tfidf, embeddings or hybrid.
# All encoders in this integration run locally on CPU.
# Install with uv sync --locked --extra embeddings --python 3.13, then rebuild.
# Docker Compose passes only RETRIEVAL_TIER and the answer settings to the backend.
RETRIEVAL_BACKEND=tfidf
EMBEDDING_MODEL=minilm
# Optional hardware tiers: auto, full, standard, light, minimal.
# To enable a tier, remove/comment RETRIEVAL_BACKEND and EMBEDDING_MODEL above;
# explicit values for either setting take precedence and disable tier selection.
# RETRIEVAL_TIER=auto
# RETRIEVAL_TIER_INDEX_DIR=data/tiers
# Other aliases: bge-m3, qwen3-0.6b, qwen3-4b (install --extra embedding-models).
RETRIEVAL_INDEX=data/index.json
RETRIEVAL_CORPUS=data/technical/documents.json
# Optional local reranking; explicitly download pinned weights before startup.
RETRIEVAL_RERANKER=none
RETRIEVAL_RERANK_CANDIDATES=40
RETRIEVAL_DIVERSITY=0
# Weighted reciprocal rank fusion. Defaults preserve equal contribution.
HYBRID_LEXICAL_WEIGHT=1
HYBRID_EMBEDDING_WEIGHT=1
HYBRID_CANDIDATES=20
# OpenAI requests use medium reasoning, no retries, a 45-second timeout,
# at most 4 passages / 16,000 serialized context characters, and 2,000 output tokens.
## Answer context remains four passages by default. Character mode is experimental.
# ANSWER_CONTEXT_MODE=characters
# Serialized context budget: 7000..16000 characters.
# ANSWER_CONTEXT_CHARS=12000
# ANSWER_CONTEXT_CANDIDATES=40

# --- Public demo controls (see docs/deployment.md) ---
# Kill switch: true disables every paid call, including visitor keys. Recorded
# example answers and the free local preview keep working.
DEMO_ONLY=false
# Live OpenAI answers per visitor (IP address; IPv6 grouped by /64) and in total,
# per UTC day. Over a limit, POST /api/ask returns HTTP 429 with the local preview.
LIVE_ANSWERS_PER_VISITOR_PER_DAY=5
LIVE_ANSWERS_PER_DAY=50
# SQLite file that keeps the counts across restarts. Docker Compose sets its own
# path on a named volume. Only hashed, per-day visitor keys are stored, never IPs.
# LIVE_QUOTA_DB=data/state/live-quota.sqlite3
# Let visitors paste their own OpenAI key. It is sent as a request header, used for
# that request only and never stored, logged or returned. It bypasses the daily
# limits above but not the 2,000-character question limit.
ALLOW_VISITOR_API_KEYS=false
# Optional Cloudflare Turnstile bot check before live answers. Set both or neither.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Proxies in front of the backend that append X-Forwarded-For: 1 for nginx in the
# default Compose stack, 2 for Caddy + nginx (docker-compose.prod.yml sets this),
# 0 to count the direct peer address.
TRUSTED_PROXY_HOPS=1
# docker-compose.prod.yml only: the public hostname Caddy serves and obtains a
# certificate for, e.g. demo.example.com or 203-0-113-7.sslip.io. The frontend also
# uses it for the absolute URLs in its link-preview tags (https://<SITE_ADDRESS>/).
SITE_ADDRESS=
