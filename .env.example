# Local preview makes no API calls. Set openai to enable document-only answers.
ANSWER_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Retrieval is independent of the answer provider: tfidf, embeddings or hybrid.
# All encoders in this integration run locally on CPU.
# Install with uv sync --locked --extra embeddings --python 3.13, then rebuild.
RETRIEVAL_BACKEND=tfidf
EMBEDDING_MODEL=minilm
# Other aliases: bge-m3, qwen3-0.6b, qwen3-4b (install --extra embedding-models).
RETRIEVAL_INDEX=data/index.json
RETRIEVAL_CORPUS=data/technical/documents.json
# Optional local reranking; explicitly download pinned weights before startup.
RETRIEVAL_RERANKER=none
RETRIEVAL_RERANK_CANDIDATES=40
RETRIEVAL_DIVERSITY=0
# Weighted reciprocal rank fusion. Defaults preserve equal contribution.
HYBRID_LEXICAL_WEIGHT=1
HYBRID_EMBEDDING_WEIGHT=1
HYBRID_CANDIDATES=20
# OpenAI requests use medium reasoning, no retries, a 45-second timeout,
# at most 4 passages / 16,000 serialized context characters, and 2,000 output tokens.
