# Local preview makes no API calls. Set openai to enable document-only answers.
ANSWER_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Retrieval is independent of the answer provider. Embeddings run locally on CPU.
# Install with uv sync --locked --extra embeddings --python 3.13, then rebuild.
RETRIEVAL_BACKEND=tfidf
RETRIEVAL_INDEX=data/index.json
RETRIEVAL_CORPUS=data/sample_documents.json
# OpenAI requests use medium reasoning, no retries, a 45-second timeout,
# at most 4 passages / 16,000 serialized context characters, and 2,000 output tokens.
